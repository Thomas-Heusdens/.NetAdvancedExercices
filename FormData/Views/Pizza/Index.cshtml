<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h1 class="display-4 mb-4">Register</h1>

            <form asp-controller="Pizza" asp-action="Toon" method="post" class="card shadow-sm p-4">

                <div class="mb-3">
                    <label for="besteller" class="form-label">Besteller</label>
                    <input type="text" id="besteller" name="besteller" class="form-control" placeholder="John Doe" />
                </div>

                <div class="mb-3">
                    <label for="pizza" class="form-label">Pizza</label>
                    <input type="text" id="pizzaNaam" name="pizzaNaam" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="kaas">Kaas</label>
                    <input type="checkbox" name="kaas" value="yes" />
                </div>

                <div class="mb-3">
                    <input type="radio" id="cash" name="betaalWijze" value="Cash">
                    <label for="cash">Cash</label><br>
                    <input type="radio" id="bancontact" name="betaalWijze" value="Bancontact">
                    <label for="bancontact">Bancontact</label><br>
                    <input type="radio" id="overschrijving" name="betaalWijze" value="Overschrijving">
                    <label for="overschrijving">Overschrijving</label>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <button type="submit" name="bestellen" value="Bestellen" class="btn btn-primary px-4">
                        Bestellen
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>