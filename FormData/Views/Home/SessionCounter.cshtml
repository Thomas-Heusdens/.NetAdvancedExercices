@{
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h1 class="display-6 mb-3">Sessie Teller</h1>

            <div class="alert alert-info shadow-sm" role="alert">
                Je hebt deze pagina tijdens deze sessie al <strong>@ViewBag.VisitCount</strong> keer bezocht.
            </div>

            <p class="text-muted mt-3">
                <small>
                    Tip: Ververs de pagina (F5) om de teller te zien stijgen.
                    Sluit je hele browser af en open hem opnieuw om te zien dat de sessie weer op 1 begint.
                </small>
            </p>
        </div>
    </div>
</div>