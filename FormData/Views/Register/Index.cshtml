<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h1 class="display-4 mb-4">Register</h1>

            <form asp-controller="Register" asp-action="Index" method="post" class="card shadow-sm p-4">

                <div class="mb-3">
                    <label for="email" class="form-label">E-mailadres</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="naam@voorbeeld.be" />
                </div>

                <div class="mb-3">
                    <label for="mailclient" class="form-label">Voorkeur E-mailclient</label>
                    <select id="mailclient" name="mailclient" class="form-select">
                        <option value="microsoft">Microsoft Outlook</option>
                        <option value="express">Outlook Express</option>
                        <option value="thunderbird">Thunderbird</option>
                        <option value="other">Other...</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Wachtwoord</label>
                    <input type="password" id="password" name="password" class="form-control" />
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <button type="submit" name="register" value="Register" class="btn btn-primary px-4">
                        Register
                    </button>
                    <button type="submit" name="forget" value="Forgot" class="btn btn-outline-secondary">
                        Forgot Password?
                    </button>
                </div>
            </form>

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success mt-4" role="alert">
                    @ViewBag.Success
                </div>
            }
        </div>
    </div>
</div>