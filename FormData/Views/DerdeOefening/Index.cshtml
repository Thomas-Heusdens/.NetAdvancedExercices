<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h1 class="display-4 mb-4">Tell us your name</h1>
            <form asp-controller="DerdeOefening" asp-action="Index" method="post" class="card shadow-sm p-4">
                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <input type="text" id="name" name="name" class="form-control" placeholder="John Doe" />
                </div>
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <button type="submit" name="myname" value="MyName" class="btn btn-primary px-4">
                        This is my name
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>