@using PassingModelData.Models
@model IEnumerable<ProductModel>

@{
    ViewData["Title"] = "Product Catalog";
}

<h2>Product Catalog</h2>

<form asp-action="Producten" method="get" class="mb-4">
    <div class="row align-items-end">
        <div class="col-md-4">
            <label for="category" class="form-label">Filter by Category:</label>
            <select name="category" id="category" class="form-select" onchange="this.form.submit()">
                <option value="" selected="@(ViewBag.SelectedCategory == null ? "selected" : null)">
                    All Categories
                </option>

                @foreach (var cat in Enum.GetValues(typeof(Category)))
                {
                    <option value="@cat"
                            selected="@(ViewBag.SelectedCategory?.ToString() == cat.ToString() ? "selected" : null)">
                        @cat
                    </option>
                }
            </select>
        </div>
    </div>
</form>

<hr />

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Category</th>
            <th>Description</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td><span class="badge bg-info text-dark">@item.Category</span></td>
                <td>@(item.Description ?? "No description available")</td>
                <td>@(item.Price.HasValue? item.Price.Value.ToString("C") : "N/A")</td>
            </tr>
        }
    </tbody>
</table>