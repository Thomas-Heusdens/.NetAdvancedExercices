@using Oefening1.Models
@model List<ProductModel>

@{
    ViewData["Title"] = "Product Catalog";
}

<h2>Product Catalog</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<form asp-action="Producten" method="get" class="mb-4">
    <div class="row align-items-end">
        <div class="col-md-4">
            <label for="category" class="form-label">Filter by Category:</label>
            <select name="category" id="category" class="form-select" onchange="this.form.submit()">
                <option value="" selected="@(ViewBag.SelectedCategory == null ? "selected" : null)">
                    All Categories
                </option>

                @foreach (var cat in Enum.GetValues(typeof(Category)))
                {
                    <option value="@cat"
                            selected="@(ViewBag.SelectedCategory?.ToString() == cat.ToString() ? "selected" : null)">
                        @cat
                    </option>
                }
            </select>
        </div>
    </div>
</form>

<hr />

<form asp-action="Overzicht" method="post">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <input type="hidden" asp-for="@Model[i].Id" />
                    <input type="hidden" asp-for="@Model[i].Name" />
                    <input type="hidden" asp-for="@Model[i].Price" />
                    <input type="hidden" asp-for="@Model[i].Category" />

                    <td>@Model[i].Name</td>
                    <td><span class="badge bg-info text-dark">@Model[i].Category</span></td>
                    <td>@(Model[i].Price.HasValue ? Model[i].Price.Value.ToString("C") : "N/A")</td>
                    <td style="width: 150px;">
                        <input asp-for="@Model[i].Quantity" class="form-control" type="number" min="0" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end">
        <button type="submit" class="btn btn-primary btn-lg">Bestellen</button>
    </div>
</form>